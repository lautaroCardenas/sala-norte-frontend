# URL del back-end Rails al que el servidor de desarrollo de Vite reenvía /api y /rails.
VITE_BACKEND_URL=http://localhost:3000

# Opcional: URL base de la API si el front se sirve separado del back (por ejemplo en un deploy).
# Por defecto es /api/v1 (pasa por el proxy de Vite).
# VITE_API_URL=https://mi-backend.example.com/api/v1
